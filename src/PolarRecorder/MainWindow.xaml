<Window x:Class="PolarRecorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PolarRec · 폴라렉" Icon="Assets/PolarRecorder.ico" Foreground="{StaticResource InkBrush}" Width="1000" Height="810" MinWidth="880" MinHeight="730" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" WindowStartupLocation="CenterScreen" Closing="OnClosing" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="88"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0"><DockPanel VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="Assets/PolarRecorder.png" Width="32" Height="32" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Polar" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="Rec" FontSize="21" VerticalAlignment="Center"/><Border Background="{StaticResource CanvasBrush}" CornerRadius="4" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="0.4.9" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Border></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LastNoticeButton" Content="최근 안내" Visibility="Collapsed" Style="{StaticResource NavButton}" Click="LastNoticeClick" ToolTip="마지막 안내 또는 오류 다시 보기"/><Button x:Name="RecordNav" Content="녹화" Style="{StaticResource NavButton}" Click="RecordNavClick"/><Button x:Name="LibraryNav" Content="내 녹화" Style="{StaticResource NavButton}" Click="LibraryNavClick"/><Button x:Name="SettingsNav" Content="설정" Style="{StaticResource NavButton}" Click="SettingsNavClick"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="24,16,24,16">
   <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="RecordPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="SettingsPanel">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource Panel}">
       <StackPanel>
        <TextBlock Text="녹화할 화면" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <RadioButton x:Name="FullScreen" Style="{StaticResource CaptureChoice}" GroupName="Capture" IsChecked="True" Checked="CaptureModeChanged" AutomationProperties.Name="전체 화면 녹화" Padding="12,8"><StackPanel><TextBlock Text="전체 화면" FontWeight="SemiBold"/><TextBlock Text="모니터 하나를 모두" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
         <RadioButton x:Name="RegionMode" Grid.Column="2" Style="{StaticResource CaptureChoice}" GroupName="Capture" Checked="CaptureModeChanged" AutomationProperties.Name="선택 영역 녹화" Padding="12,8"><StackPanel><TextBlock Text="선택 영역" FontWeight="SemiBold"/><TextBlock Text="필요한 부분만" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
        </Grid>
        <RadioButton x:Name="WindowMode" Style="{StaticResource CaptureChoice}" GroupName="Capture" Checked="CaptureModeChanged" Margin="0,8,0,0" Padding="12,8" AutomationProperties.Name="앱 또는 브라우저 창 녹화"><StackPanel><TextBlock Text="앱 · 브라우저 창" FontWeight="SemiBold"/><TextBlock Text="선택한 창만 담기" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
        <StackPanel x:Name="WindowPicker" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock Text="녹화할 창" Style="{StaticResource Muted}"/>
         <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="WindowList" DropDownOpened="WindowListOpened" TextSearch.TextPath="Label" Tag="녹화할 앱 창을 선택하세요" SelectionChanged="WindowSelectionChanged" AutomationProperties.Name="녹화할 앱 창" MinWidth="0" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}">
           <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding App}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
         </Grid>
         <TextBlock Text="일반 앱 창을 선택하세요. 바탕화면·오버레이·보조 창은 목록에서 제외합니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="MonitorLabel" Text="모니터" Style="{StaticResource Muted}" Margin="0,12,0,8"/>
        <ComboBox x:Name="ScreenList" Tag="녹화할 모니터를 선택하세요" AutomationProperties.Name="녹화 모니터" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button x:Name="SelectRegionButton" Content="영역 지정하기" Click="SelectRegionClick" Margin="0,8,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="RegionLabel" Text="선택한 모니터 전체를 녹화합니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="소리와 포인터" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="SystemAudio" MinHeight="24" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" AutomationProperties.Name="PC 전체 소리 녹음" ToolTip="켜면 선택한 앱뿐 아니라 PC 전체 소리가 녹음됩니다."><TextBlock Text="PC 전체 소리" FontWeight="SemiBold"/></CheckBox>
        <CheckBox x:Name="MicAudio" MinHeight="24" Checked="OptionChanged" Unchecked="OptionChanged" AutomationProperties.Name="마이크 녹음" Margin="0,8,0,0"><TextBlock Text="마이크" FontWeight="SemiBold"/></CheckBox>
        <CheckBox x:Name="CursorOption" MinHeight="24" Content="마우스 포인터 포함" IsChecked="True" Margin="0,8,0,0" AutomationProperties.Name="마우스 포인터 포함"/>
        <TextBlock Text="PC 소리는 다른 앱의 소리도 포함합니다. 마이크는 Windows 기본 장치를 사용합니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="미리보기" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
         <Button x:Name="PreviewButton" Grid.Column="1" Content="미리보기 갱신" Click="PreviewClick" Padding="8,8" MinHeight="32" FontSize="12" ToolTip="선택한 대상을 한 번 캡처합니다. 임시 이미지는 처리 후 삭제됩니다." AutomationProperties.Name="미리보기 갱신"/>
        </Grid>
        <Border Grid.Row="1" MinHeight="180" Background="{StaticResource CanvasBrush}" CornerRadius="8" ClipToBounds="True">
         <Grid><StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="100" Height="60" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" CornerRadius="6"><Grid><Rectangle Margin="16,12" Stroke="{StaticResource ActionBrush}" StrokeDashArray="3 2" StrokeThickness="1.5"/><Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"/></Grid></Border><TextBlock Text="녹화 전에 선택한 화면을 확인하세요" HorizontalAlignment="Center" FontSize="12" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel><Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="280"/></Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CaptureSummary" Text="전체 화면" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="MP4 · 30 FPS" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Grid><TextBlock x:Name="AudioSummary" Text="PC 소리 켜짐 · 마이크 꺼짐" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       </Grid>
      </Border>
      <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,12,0,0">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="저장 위치" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="FolderButton" Grid.Column="1" Content="변경" Click="FolderClick" MinHeight="28" Padding="8,4" FontSize="11"/></Grid>
        <TextBlock Grid.Row="1" x:Name="FolderLabel" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}" Margin="0,12,0,12" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Row="2" Text="녹화를 마치면 MP4로 저장합니다.&#10;파일 이름은 날짜와 시간으로 자동 생성됩니다." Style="{StaticResource Muted}" FontSize="11"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Grid.Row="2" x:Name="SetupBanner" Background="{StaticResource IceBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel><Button Content="복구 안내" Click="RepairHelpClick" DockPanel.Dock="Right" MinHeight="30" FontSize="11" Padding="8,4" Margin="12,0,0,0"/><StackPanel><TextBlock Text="앱 파일을 확인해 주세요" FontWeight="SemiBold"/><TextBlock Text="구성 파일이 누락되어 녹화를 시작할 수 없어요." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    </Grid>
   </ScrollViewer>
   <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="내 녹화" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="현재 저장 폴더의 최근 영상 50개" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button Content="저장 폴더 열기" Click="OpenFolderClick" HorizontalAlignment="Right"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="아직 저장된 영상이 없어요" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="첫 녹화를 저장하면 여기에서 바로 열 수 있습니다." Style="{StaticResource Muted}" Margin="0,8,0,16"/><Button Content="녹화하러 가기" Click="RecordNavClick" HorizontalAlignment="Center"/></StackPanel><ListBox x:Name="RecordingsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RecordingDoubleClick" KeyDown="RecordingKeyDown" AutomationProperties.Name="저장된 녹화 영상"><ListBox.ItemTemplate><DataTemplate><Border Padding="12,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="열기" Click="OpenRecordingClick" Tag="{Binding Path}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
   <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="PreferencesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="설정" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <StackPanel x:Name="PreferencesEditor">
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="저장 폴더" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="폴더 선택" Click="FolderClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="저장 폴더 경로"/></DockPanel></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="단축키 설정" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="다른 앱을 사용 중일 때도 녹화를 제어할 수 있습니다." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="녹화 시작 / 저장" VerticalAlignment="Center" FontWeight="SemiBold"/>
       <ComboBox x:Name="StartModifiers" Grid.Column="1" MinHeight="40" AutomationProperties.Name="녹화 시작 저장 보조 키"/>
       <ComboBox x:Name="StartKey" Grid.Column="3" MinHeight="40" AutomationProperties.Name="녹화 시작 저장 기능 키"/>
       <TextBlock Grid.Row="2" Text="일시정지 / 계속" VerticalAlignment="Center" FontWeight="SemiBold"/>
       <ComboBox x:Name="PauseModifiers" Grid.Row="2" Grid.Column="1" MinHeight="40" AutomationProperties.Name="일시정지 계속 보조 키"/>
       <ComboBox x:Name="PauseKey" Grid.Row="2" Grid.Column="3" MinHeight="40" AutomationProperties.Name="일시정지 계속 기능 키"/>
      </Grid>
      <TextBlock Text="Ctrl·Alt·Shift 조합과 F1–F11 중에서 선택하세요. Esc는 영역 선택·시작 대기 취소로 고정됩니다." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
      <TextBlock x:Name="ShortcutStatus" Text="변경한 단축키는 적용 후 저장됩니다." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="기본값으로 선택" Click="ResetShortcutsClick" Margin="0,0,8,0"/><Button Content="단축키 적용" Style="{StaticResource PrimaryButton}" Click="ApplyShortcutsClick"/></StackPanel>
     </StackPanel></Border>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="1" Panel.ZIndex="20" x:Name="NoticePanel" Visibility="Collapsed" VerticalAlignment="Top" MaxWidth="680" Background="{StaticResource IceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="24,12,24,0" AutomationProperties.LiveSetting="Polite">
   <Border.RenderTransform><TranslateTransform x:Name="NoticeOffset"/></Border.RenderTransform>
   <DockPanel><Button Content="닫기" Click="DismissNotice" DockPanel.Dock="Right" Padding="8,2" MinHeight="28" Margin="12,0,0,0" VerticalAlignment="Top"/><ScrollViewer FocusVisualStyle="{x:Null}" MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NoticeLabel" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/></ScrollViewer></DockPanel>
  </Border>
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource ActionBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusLabel" Text="녹화 준비" FontWeight="SemiBold"/><TextBlock x:Name="ClockLabel" Text="00:00:00" FontFamily="Consolas" FontSize="22" Margin="16,-4,0,0"/></StackPanel><TextBlock x:Name="HintLabel" Text="3초 준비 후 녹화를 시작합니다." Style="{StaticResource Muted}" Margin="0,7,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LastVideoButton" Content="영상 열기" Click="LastVideoClick" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="CancelButton" Content="시작 취소" Click="CancelStartClick" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="PauseButton" Content="일시정지" Click="PauseClick" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="■  저장하고 종료" Style="{StaticResource PrimaryButton}" Click="StopClick" Visibility="Collapsed"/><Button x:Name="StartButton" Content="●  녹화 시작" Style="{StaticResource PrimaryButton}" Click="StartClick" MinWidth="150" ToolTip="Ctrl + Shift + F9"/></StackPanel></Grid></Border>
 </Grid>
</Window>
