<Window x:Class="PolarRecorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PolarRec · 폴라렉" Icon="Assets/PolarRecorder.ico" Foreground="{StaticResource InkBrush}" Width="1000" Height="810" MinWidth="880" MinHeight="730" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" WindowStartupLocation="CenterScreen" Closing="OnClosing" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0"><DockPanel VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="Assets/PolarRecorder.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Polar" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="Rec" FontSize="21" VerticalAlignment="Center"/><Border Background="{StaticResource CanvasBrush}" CornerRadius="4" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="0.4.0" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Border></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RecordNav" Content="녹화" Style="{StaticResource NavButton}" Click="RecordNavClick"/><Button x:Name="LibraryNav" Content="내 녹화" Style="{StaticResource NavButton}" Click="LibraryNavClick"/><Button x:Name="SettingsNav" Content="설정" Style="{StaticResource NavButton}" Click="SettingsNavClick"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="24,20,24,16">
   <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="RecordPage" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="SettingsPanel">
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="녹화할 화면" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="FullScreen" Style="{StaticResource CaptureChoice}" GroupName="Capture" IsChecked="True" Checked="CaptureModeChanged" AutomationProperties.Name="전체 화면 녹화"><StackPanel><TextBlock Text="전체 화면" FontWeight="SemiBold"/><TextBlock Text="모니터 하나를 모두" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></RadioButton><RadioButton x:Name="RegionMode" Grid.Column="2" Style="{StaticResource CaptureChoice}" GroupName="Capture" Checked="CaptureModeChanged" AutomationProperties.Name="선택 영역 녹화"><StackPanel><TextBlock Text="선택 영역" FontWeight="SemiBold"/><TextBlock Text="필요한 부분만" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></RadioButton></Grid><RadioButton x:Name="WindowMode" Style="{StaticResource CaptureChoice}" GroupName="Capture" Checked="CaptureModeChanged" Margin="0,10,0,0" AutomationProperties.Name="앱 또는 브라우저 창 녹화"><StackPanel><TextBlock Text="앱 · 브라우저 창" FontWeight="SemiBold"/><TextBlock Text="선택한 창만 담기" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></RadioButton><StackPanel x:Name="WindowPicker" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="녹화할 창" Style="{StaticResource Muted}"/><ComboBox x:Name="WindowList" DisplayMemberPath="Label" SelectionChanged="WindowSelectionChanged" AutomationProperties.Name="녹화할 앱 창" Margin="0,6,0,0"/><Button x:Name="RefreshWindowsButton" Content="창 목록 새로고침" Click="RefreshWindowsClick" Margin="0,8,0,0"/><TextBlock Text="웹은 별도 브라우저 창으로 열어 선택하세요. 탭을 바꾸면 바뀐 탭이 녹화됩니다. 최소화하면 일시정지합니다." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><TextBlock x:Name="MonitorLabel" Text="모니터" Style="{StaticResource Muted}" Margin="0,16,0,6"/><ComboBox x:Name="ScreenList" AutomationProperties.Name="녹화 모니터"/><Button x:Name="SelectRegionButton" Content="영역 지정하기" Click="SelectRegionClick" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="RegionLabel" Text="선택한 모니터 전체를 녹화합니다." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="함께 담을 소리" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="SystemAudio" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" AutomationProperties.Name="PC 소리 녹음"><StackPanel><TextBlock Text="PC 전체 소리" FontWeight="SemiBold"/><TextBlock Text="영상, 음악 등 컴퓨터에서 나는 소리" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></CheckBox><Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/><CheckBox x:Name="MicAudio" Checked="OptionChanged" Unchecked="OptionChanged" AutomationProperties.Name="마이크 녹음"><StackPanel><TextBlock Text="마이크" FontWeight="SemiBold"/><TextBlock Text="내 목소리와 주변 소리" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></CheckBox><TextBlock Text="Windows 기본 장치의 전체 소리입니다. 선택한 앱만의 소리가 아닙니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border>
     <CheckBox x:Name="CursorOption" Content="마우스 포인터 포함" IsChecked="True" Margin="4,10,4,0" AutomationProperties.Name="마우스 포인터 포함"/>
    </StackPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Panel}"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="녹화 영역 확인" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/><Button x:Name="PreviewButton" Grid.Column="1" Click="PreviewClick" Padding="10,6" MinHeight="32" FontSize="12" VerticalAlignment="Center" ToolTip="선택한 대상을 한 번 캡처합니다. 창 미리보기의 임시 이미지는 처리 후 삭제됩니다." AutomationProperties.Name="미리보기 새로고침"><StackPanel Orientation="Horizontal"><Path Data="M 12,4 A 5,5 0 1 0 13,10 M 12,1 L 12,5 L 8,5" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="새로고침"/></StackPanel></Button></Grid><Border Height="208" Background="{StaticResource CanvasBrush}" CornerRadius="8" ClipToBounds="True"><Grid><StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="110" Height="68" BorderBrush="#94B5CE" BorderThickness="2" CornerRadius="6"><Grid><Rectangle Margin="20,12" Stroke="{StaticResource ActionBrush}" StrokeDashArray="3 2" StrokeThickness="1.5"/><Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"/></Grid></Border><TextBlock Text="시작 전에 화면을 확인하세요" HorizontalAlignment="Center" FontSize="12" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel><Image x:Name="PreviewImage" Stretch="Uniform"/></Grid></Border><DockPanel Margin="0,12,0,0"><TextBlock x:Name="CaptureSummary" Text="전체 화면" FontWeight="SemiBold"/><TextBlock Text="MP4 · 30 FPS" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/></DockPanel><TextBlock x:Name="AudioSummary" Text="PC 소리 켜짐 · 마이크 꺼짐" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><DockPanel><TextBlock Text="저장 위치" FontWeight="SemiBold"/><Button x:Name="FolderButton" Content="변경" Click="FolderClick" HorizontalAlignment="Right" MinHeight="28" Padding="9,3" FontSize="11"/></DockPanel><TextBlock x:Name="FolderLabel" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock Text="날짜와 시간으로 파일 이름을 자동 생성합니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" x:Name="SetupBanner" Background="{StaticResource IceBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0"><DockPanel><Button Content="복구 안내" Click="RepairHelpClick" DockPanel.Dock="Right" MinHeight="30" FontSize="11" Padding="10,5" Margin="12,0,0,0"/><StackPanel><TextBlock Text="앱 파일을 확인해 주세요" FontWeight="SemiBold"/><TextBlock Text="구성 파일이 누락되어 녹화를 시작할 수 없어요." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    </Grid>
   </Grid></ScrollViewer>
   <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="내 녹화" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="현재 저장 폴더의 최근 영상 50개" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button Content="저장 폴더 열기" Click="OpenFolderClick" HorizontalAlignment="Right"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="아직 저장된 영상이 없어요" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="첫 녹화를 저장하면 여기에서 바로 열 수 있습니다." Style="{StaticResource Muted}" Margin="0,10,0,20"/><Button Content="녹화하러 가기" Click="RecordNavClick" HorizontalAlignment="Center"/></StackPanel><ListBox x:Name="RecordingsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RecordingDoubleClick" KeyDown="RecordingKeyDown" AutomationProperties.Name="저장된 녹화 영상"><ListBox.ItemTemplate><DataTemplate><Border Padding="12,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="열기" Click="OpenRecordingClick" Tag="{Binding Path}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
   <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="PreferencesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="설정" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/><StackPanel x:Name="PreferencesEditor"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="녹화 기능" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="EngineStatus" Style="{StaticResource Muted}"/><TextBlock Text="필요한 구성 요소는 앱에 포함되어 자동으로 연결됩니다." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="저장 폴더" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="폴더 선택" Click="FolderClick" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="저장 폴더 경로"/></DockPanel></StackPanel></Border></StackPanel><Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="키보드로 빠르게" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ctrl + Shift + F9     녹화 시작 / 저장" Margin="0,0,0,10"/><TextBlock Text="Ctrl + Shift + F10   일시정지 / 계속" Margin="0,0,0,10"/><TextBlock Text="Esc                         영역 선택 / 시작 대기 취소"/><TextBlock Text="녹화 시작 후 창이 최소화됩니다. 단축키 또는 작업 표시줄의 앱으로 돌아와 저장하세요." Style="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" x:Name="NoticePanel" Visibility="Collapsed" Background="#FFF3EB" BorderBrush="#E5C6AD" BorderThickness="1" CornerRadius="7" Padding="12" Margin="24,0,24,12"><DockPanel><Button Content="닫기" Click="DismissNotice" DockPanel.Dock="Right" Padding="8,2" MinHeight="26" Margin="12,0,0,0"/><ScrollViewer FocusVisualStyle="{x:Null}" MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NoticeLabel" Foreground="#713D20" TextWrapping="Wrap"/></ScrollViewer></DockPanel></Border>
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource ActionBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusLabel" Text="녹화 준비" FontWeight="SemiBold"/><TextBlock x:Name="ClockLabel" Text="00:00:00" FontFamily="Consolas" FontSize="22" Margin="16,-4,0,0"/></StackPanel><TextBlock x:Name="HintLabel" Text="3초 준비 후 녹화를 시작합니다." Style="{StaticResource Muted}" Margin="0,7,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LastVideoButton" Content="영상 열기" Click="LastVideoClick" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="CancelButton" Content="시작 취소" Click="CancelStartClick" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="PauseButton" Content="일시정지" Click="PauseClick" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="■  저장하고 종료" Style="{StaticResource PrimaryButton}" Click="StopClick" Visibility="Collapsed"/><Button x:Name="StartButton" Content="●  녹화 시작" Style="{StaticResource PrimaryButton}" Click="StartClick" MinWidth="150" ToolTip="Ctrl + Shift + F9"/></StackPanel></Grid></Border>
 </Grid>
</Window>
